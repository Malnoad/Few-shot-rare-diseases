{
  "permissions": {
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(ln -s *)",
      "Bash(ln -sf *)",
      "Bash(gh pr merge *)"
    ],
    "ask": [
      "Bash(git reset *--hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.agents/run-python.sh\" .agents/tool_guard.py claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-done.sh\""
          }
        ]
      }
    ]
  }
}
